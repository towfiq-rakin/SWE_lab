# Production domain
APP_DOMAIN=auction-studio.rakin.me

# Django runtime
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=auction-studio.rakin.me,localhost,127.0.0.1
DJANGO_SQLITE_PATH=/app/data/db.sqlite3

# Browser origins allowed for cross-origin/session + CSRF
# Keep both https and http entries if you may test without TLS first.
DJANGO_CORS_ALLOWED_ORIGINS=https://auction-studio.rakin.me,http://auction-studio.rakin.me
DJANGO_CSRF_TRUSTED_ORIGINS=https://auction-studio.rakin.me,http://auction-studio.rakin.me

# Gunicorn tuning
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# Frontend build/runtime
VITE_API_BASE_URL=/api
FRONTEND_PORT=80
